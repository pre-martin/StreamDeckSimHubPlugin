<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>StreamDeckSimHub.Installer</AssemblyName>
    <RootNamespace>StreamDeckSimHub.Installer</RootNamespace>
    <!-- Keep the classic output layout (bin\Debug, bin\Release) without a TargetFramework subfolder. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Data" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Numerics" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xaml">
      <RequiredTargetFramework>4.0</RequiredTargetFramework>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="NLog.config" />
    <EmbeddedResource Include="..\build\net.planetrenner.simhub.streamDeckPlugin" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="NLog" Version="5.3.3" />
  </ItemGroup>

  <!--
    Replacement for Costura.Fody: embed the runtime assemblies of the NuGet dependencies above
    (and their transitive dependencies) directly into the executable, so that end users only need
    to download a single EXE file. The dependencies are removed from the normal "copy to output"
    list and instead added as EmbeddedResource. AssemblyLoader (see Tools/AssemblyLoader.cs)
    resolves them at runtime via AppDomain.AssemblyResolve.
  -->
  <Target Name="EmbedRuntimeDependencies" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_EmbeddedDependency Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
      <EmbeddedResource Include="@(_EmbeddedDependency)">
        <LogicalName>%(_EmbeddedDependency.Filename)%(_EmbeddedDependency.Extension)</LogicalName>
      </EmbeddedResource>
      <!-- Remove from copy-local so the DLLs are not additionally copied next to the EXE. -->
      <ReferenceCopyLocalPaths Remove="@(_EmbeddedDependency)" />
    </ItemGroup>
  </Target>

  <Target Name="RenameInstaller" AfterTargets="Build">
    <Copy SourceFiles="$(BaseOutputPath)\$(Configuration)\$(AssemblyName).exe" DestinationFiles="$(BaseOutputPath)\$(Configuration)\$(AssemblyName)-v$(BuildVersion3Components).exe" />
  </Target>

</Project>
